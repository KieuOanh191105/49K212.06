# ==================== ENVIRONMENT VARIABLES FOR PRODUCTION (RENDER) ====================
# Đây là file mẫu cho môi trường production
# KHÔNG commit file này vào git (nếu có thông tin thật)
# Copy nội dung này vào Render Dashboard > Environment Variables

# ==================== SECURITY ====================
# Secret Key: Tạo random string tại https://djecrety.ir/
SECRET_KEY=your-secret-key-here-please-change-this

# Debug: Luôn là False trong production
DEBUG=False

# Allowed Hosts: Domain của app trên Render
# Ví dụ: due-book-app.onrender.com hoặc *.onrender.com để cho phép tất cả subdomain
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1

# ==================== SITE CONFIGURATION ====================
# QUAN TRỌNG: URL của app trên Render
# Ví dụ: https://due-book-app.onrender.com
SITE_URL=https://your-app-name.onrender.com

# ==================== EMAIL CONFIGURATION ====================
# Cấu hình Gmail để gửi email reset password
# Lưu ý: Cần tạo App Password tại https://myaccount.google.com/apppasswords

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Email của bạn để gửi email
EMAIL_HOST_USER=vanthan1992.qn@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=DUE Book <vanthan1992.qn@gmail.com>

# ==================== DATABASE ====================
# Render tự động cung cấp DATABASE_URL
# Không cần cấu hình DB_NAME, DB_USER, etc.

# ==================== LƯU Ý QUAN TRỌNG ====================
# 1. Secret Key: PHẢI đổi random string cho production
# 2. SITE_URL: PHẢI update thành URL thật của app trên Render
# 3. Email: PHẢI dùng App Password (không dùng password thường)
# 4. DATABASE_URL: Render tự động tạo, KHÔNG cần cấu hình
